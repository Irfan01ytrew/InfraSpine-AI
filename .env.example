# Copy to .env and fill in values. Never commit .env.
# AI provider API keys are NOT configured here: add them in the admin UI,
# where they are verified and stored encrypted in PostgreSQL.

# --- Application ---
APP_NAME=InfraSpine AI
# development | testing | staging | production  (production disables /docs)
APP_ENV=development
LOG_LEVEL=INFO

# --- Database (PostgreSQL, asyncpg driver) ---
DATABASE_URL=postgresql+asyncpg://infraspine_app:CHANGE_ME@localhost:5432/infraspine_ai

# --- Credential encryption ---
# 32 random bytes, base64. Generate with: python -m app.cli generate-master-key
# In production supply this from a secret manager. Losing it makes stored
# provider keys unreadable (re-enter them); leaking it exposes them.
MASTER_ENCRYPTION_KEY=
MASTER_ENCRYPTION_KEY_ID=v1
# Previous master key (Step I slice 5): set BOTH lines only while a rotation
# is in flight - new key as MASTER_ENCRYPTION_KEY, old key here - then remove
# both once the rotation sweep reports zero stale credentials. See
# docs/step-i-key-rotation-runbook.md.
MASTER_ENCRYPTION_KEY_PREVIOUS=
MASTER_ENCRYPTION_KEY_PREVIOUS_ID=

# --- LLM runtime ---
LLM_LOCAL_ONLY=false
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
# Optional backup provider ID from the admin provider list (for example a configured local Ollama model).
LLM_FALLBACK_PROVIDER=
PROVIDER_VERIFY_TIMEOUT_SECONDS=15
# Agent Studio persists user tasks before execution. Enable only on the designated worker-owner process.
AGENT_STUDIO_WORKER_ENABLED=false
AGENT_STUDIO_WORKER_POLL_SECONDS=1
AGENT_STUDIO_RUN_TIMEOUT_SECONDS=300
# Optional exact rate card keyed by "provider:model"; omit a model to leave its cost unavailable.
LLM_MODEL_PRICING_JSON={}
# Custom (admin-added) providers must use public HTTPS endpoints. To allow an approved internal model
# server, list its exact origin(s), comma-separated, e.g. http://127.0.0.1:11434,https://llm.corp.local:8443
# Link-local/metadata addresses (169.254.0.0/16 etc.) stay blocked even when listed.
PROVIDER_TRUSTED_PRIVATE_ORIGINS=

# --- Authentication ---
SESSION_TTL_MINUTES=480
# Must be true in production (HTTPS). Set false only for local http development.
SESSION_COOKIE_SECURE=true
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Operator-owned policy: enforce a TOTP factor for every employee account.
ORG_MFA_REQUIRED=false
# Step I slice 6: emit Strict-Transport-Security (max-age 1 year +
# includeSubDomains). Only set true behind HTTPS; enabling it on a live
# deployment is an owner decision (a wrong HSTS header pins browsers to
# HTTPS). Permissions-Policy (camera/mic/geolocation/payment/USB denied)
# is always sent and needs no setting.
HSTS_ENABLED=false

# --- Communication platforms (Slack & Microsoft Teams) ---
# Teams Bot Framework: TEAMS_ENABLED=true + TEAMS_APP_ID (the Microsoft
# app id) enables POST /api/integrations/teams/messages, which accepts
# only Bot Framework bearer tokens for that app id (RS256, issuer
# https://api.botframework.com). TEAMS_APP_PASSWORD is the bot's
# credential for outbound Bot Framework calls. Slack needs
# SLACK_ENABLED=true + SLACK_SIGNING_SECRET (HMAC verification).
SLACK_ENABLED=false
SLACK_SIGNING_SECRET=
TEAMS_ENABLED=false
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=

# --- Offline deployment licensing ---
# Publisher's base64-encoded 32-byte Ed25519 public key. Never put the private signing key here.
# LICENSE_ENFORCEMENT_ENABLED=true gates application APIs until a valid signed license is installed.
LICENSE_PUBLIC_KEY=
LICENSE_ENFORCEMENT_ENABLED=false

# --- RAG (documents & knowledge chat) ---
# Local folder for uploads/, vector_index/ and models/. Never served over HTTP; keep it private and backed up.
RAG_DATA_DIR=data
# Optional local image fallback (model can be downloaded with scripts/download_local_image_model.py).
# Store model weights outside the source tree and set this to their local directory.
RAG_LOCAL_IMAGE_MODEL_PATH=
WHATSAPP_WEBHOOK_BASE_URL=
RAG_LOCAL_IMAGE_CPU_THREADS=6
RAG_LOCAL_IMAGE_STEPS=4
RAG_LOCAL_IMAGE_SIZE=512
RAG_MAX_UPLOAD_MB=20
# Admin-managed local-folder imports can exceed browser upload size; each file is still bounded.
RAG_IMPORT_MAX_FILE_MB=4096
# Scheduled folder sync accepts relative paths only beneath this operator-managed root.
RAG_IMPORT_ROOT=data/import
# Optional local-only transcription for WAV/MP3/M4A/FLAC/OGG/AAC and video audio tracks.
# Install requirements-media.txt, stage a CTranslate2 Whisper model locally, then enable this flag.
RAG_MEDIA_ENABLED=false
RAG_MEDIA_MODEL_PATH=
RAG_MEDIA_DEVICE=cpu
RAG_MEDIA_CPU_THREADS=4
RAG_OCR_CPU_THREADS=1
RAG_MEDIA_MAX_FILE_MB=8192
RAG_MEDIA_MAX_DURATION_SECONDS=14400
RAG_MEDIA_SEGMENT_SECONDS=300
RAG_MEDIA_VIDEO_FRAME_OCR_ENABLED=true
RAG_MEDIA_VIDEO_FRAME_INTERVAL_SECONDS=30
RAG_MEDIA_VIDEO_MAX_FRAMES=300
# Optional public market research via the configured Gemini API; queries are sent to Google Search.
RAG_EXTERNAL_RESEARCH_ENABLED=false
# Public-search fallback after Google grounding is unavailable: auto, duckduckgo, bing_rss, or yahoo.
RAG_PUBLIC_SEARCH_PROVIDER=auto
# When true, only admins and assigned managers may upload; managers are limited to their departments.
# Employees can still ask about documents they are allowed to read.
RAG_ADMIN_ONLY_UPLOADS=true
# Pages, slides or sheets per file.
RAG_MAX_PAGES=500
# Office files (ZIP packages) that expand beyond this are rejected.
RAG_MAX_UNPACKED_MB=256
# Chunk size/overlap in characters (overlap must be < half the size). ~800 chars fits the model's 256-token window.
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
# Local CPU embedding model (downloaded once into RAG_DATA_DIR/models). Changing it re-embeds all documents.
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_DIMENSION=384
# Development default preserves first-use model downloads. On-prem Compose defaults this to false; pre-stage the model.
RAG_EMBEDDING_ALLOW_DOWNLOAD=true
# Vector index backend. Only "faiss" is supported; another value fails at startup.
RAG_VECTOR_STORE=faiss
RAG_QDRANT_URL=http://127.0.0.1:6333
# Only set when Qdrant API key authentication is enabled; keep this value in the deployment secret store.
# RAG_QDRANT_API_KEY=
# Retrieval: top-k chunks sent to the LLM, and a minimum cosine similarity that only filters clear noise
# (overview questions like "summarize this report" typically score 0.25-0.30 with this model).
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.2
RAG_MAX_CONTEXT_CHARS=12000
# Whole-document questions (summarize / check this report) send up to this many characters, in page order.
RAG_OVERVIEW_MAX_CHARS=40000
# Document processing. worker = separate process (`python -m app.worker`); embedded = inside the API process.
RAG_INGESTION_MODE=worker
# Embedded mode only: run the worker loop inside the API process.
RAG_WORKER_ENABLED=true
RAG_WORKER_CONCURRENCY=1
# Each file is parsed in a child process that is stopped after this time / above this memory (0 = no memory cap).
RAG_PARSE_ISOLATION=true
RAG_PROCESSING_TIMEOUT_SECONDS=600
# Caps committed memory per parser process. Table-heavy and scanned PDFs measured 3.3-3.6 GB committed under
# Docling; below that the parser crashes instead of failing cleanly. Budget this much RAM per worker slot.
RAG_PARSER_MEMORY_MB=4096
# Use Docling for PDF, DOCX and PPTX on supported Linux hosts. Native Windows PDF parsing uses the built-in parser.
RAG_USE_DOCLING=true
# Enable offline RapidOCR fallback for scanned PDFs; requires local RapidOCR ONNX models.
RAG_OCR_ENABLED=true
# Lease on a claimed job (renewed while processing); an abandoned job is taken over after it expires.
RAG_PROCESSING_LEASE_SECONDS=60
RAG_WORKER_SHUTDOWN_GRACE_SECONDS=30
# Optional assignment deadline email. Disabled by default; use verified TLS to a relay you control.
PERSONAL_TASK_EMAIL_ENABLED=false
PERSONAL_TASK_SMTP_HOST=
PERSONAL_TASK_SMTP_PORT=587
PERSONAL_TASK_SMTP_SECURITY=starttls
PERSONAL_TASK_SMTP_USERNAME=
PERSONAL_TASK_SMTP_PASSWORD=
PERSONAL_TASK_EMAIL_FROM=
PERSONAL_TASK_SMTP_TIMEOUT_SECONDS=15

# --- Optional module dispatch workers ---
# These workers can perform approved workflow actions, recovery actions, or external connector syncs.
# Keep off until their owning module, credentials, approvals, and tenant scope are verified.
# Unified workflow runtime (automations, approvals, invoice batches, Agent Studio runs, governance actions).
# On by default (API owner process and `python -m app.worker`); every action it dispatches is already
# permission-checked and approved per step. Kill switch: set to false and restart the API and worker.
WORKFLOW_ENGINE_WORKER_ENABLED=true
# Finance payment connector: mock (test bank, refused when APP_ENV=production) or http. An administrator can
# override the choice (mock / http / http+mock) in Finance > Payment connector; URL and token stay here.
# FINANCE_PAYMENT_CONNECTOR=mock
# FINANCE_PAYMENT_FALLBACK=
# FINANCE_BANK_API_URL=
# FINANCE_BANK_API_TOKEN=
RECOVERY_WORKER_ENABLED=false
INTEGRATION_WORKER_ENABLED=false
# How often the API applies new chunks written by workers to its vector index (seconds; 0 = off).
RAG_INDEX_SYNC_SECONDS=2
RAG_MAX_ATTEMPTS=3

# --- Observability ---
# Rotating log files (infraspine.log, worker.log) in this folder, so a failed request's traceback outlives the
# terminal that started the server. Empty = stdout only.
LOG_DIR=logs
# One metadata-only trace per question (no question, answer or document text), shown on the admin Traces page.
RAG_TRACE_ENABLED=true
RAG_TRACE_RETENTION_DAYS=30
# Embedding model cache; empty = RAG_DATA_DIR/models.
RAG_MODELS_DIR=

# --- Page images of Word / PowerPoint / Excel ---
# Rendered through LibreOffice (converted to PDF once, cached next to the upload). Empty = auto-detect soffice on
# PATH or in the standard install folder. Without LibreOffice only PDF pages can be shown as images.
RAG_OFFICE_CONVERTER=
RAG_PREVIEW_TIMEOUT_SECONDS=120

# --- Docker Compose ---
# For the production Compose stack, copy .env.docker.example to .env next to
# compose.yaml and follow docs/deploy-docker.md. Do not reuse a workstation
# DATABASE_URL that points at a live Windows Postgres instance.
