# Copy to .env next to compose.yaml. Never commit the real .env.
# Generate a master key:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"

# --- Compose / Postgres ---
POSTGRES_DB=infraspine_ai
POSTGRES_USER=infraspine_app
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://infraspine_app:CHANGE_ME@postgres:5432/infraspine_ai

# --- Application ---
APP_ENV=production
APP_NAME=InfraSpine AI
MASTER_ENCRYPTION_KEY=
MASTER_ENCRYPTION_KEY_ID=v1
SESSION_COOKIE_SECURE=true
LOG_LEVEL=INFO

# --- Images / build args ---
INFRASPINE_IMAGE=infraspine-ai:local
INFRASPINE_FRONTEND_IMAGE=infraspine-frontend:local
INSTALL_MEDIA_RUNTIME=false
INSTALL_BAILEYS=false
API_WORKERS=1
API_SERVER=uvicorn

# --- RAG ---
RAG_VECTOR_STORE=faiss
RAG_EMBEDDING_ALLOW_DOWNLOAD=true
RAG_EXTERNAL_RESEARCH_ENABLED=false
RAG_MEDIA_ENABLED=false

# --- Workflow engine worker ---
# On by default (API owner process and `python -m app.worker`); set false to stop it.
WORKFLOW_ENGINE_WORKER_ENABLED=true

# --- Optional Qdrant (compose profile: qdrant) ---
# RAG_QDRANT_URL=http://qdrant:6333
# RAG_QDRANT_API_KEY=

# --- Published ports (bound to 127.0.0.1) ---
INFRASPINE_HTTP_PORT=80
INFRASPINE_HTTPS_PORT=443

# --- Backup ---
BACKUP_KEEP=14
BACKUP_INTERVAL_SECONDS=86400

# --- Local LLM (compose profile: ollama) ---
# PROVIDER_TRUSTED_PRIVATE_ORIGINS=http://ollama:11434
