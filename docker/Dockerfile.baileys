# syntax=docker/dockerfile:1.7
# Optional image of the unofficial WhatsApp Web bridge.
# In the default compose stack the API supervises integrations/whatsapp-baileys/bridge.mjs
# itself (stdin/stdout pipes). Build this image only when you want a standalone Node
# environment for development or a future socket-based sidecar.
FROM node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d
RUN useradd --system --uid 10001 --create-home --shell /usr/sbin/nologin baileys
WORKDIR /opt/baileys
COPY integrations/whatsapp-baileys/package.json integrations/whatsapp-baileys/package-lock.json ./
RUN npm ci --omit=dev --omit=optional
COPY integrations/whatsapp-baileys/ ./
USER 10001:10001
CMD ["node", "bridge.mjs"]
