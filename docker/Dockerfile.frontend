# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d AS frontend-build
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM nginx:1.28-alpine@sha256:a8b39bd9cf0f83869a2162827a0caf6137ddf759d50a171451b335cecc87d236
RUN apk add --no-cache curl \
    && mkdir -p /var/cache/nginx /var/log/nginx /var/run /tmp \
    && chown -R nginx:nginx /var/cache/nginx /var/log/nginx /var/run /tmp /etc/nginx /usr/share/nginx/html
COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY docker/nginx/tls.conf.optional /etc/nginx/conf.d/tls.conf.optional
COPY docker/nginx/tls.conf.template /etc/nginx/tls.conf.template
COPY docker/nginx/docker-entrypoint.sh /docker-entrypoint-tls.sh
RUN chmod 755 /docker-entrypoint-tls.sh
COPY --from=frontend-build /src/frontend/dist /usr/share/nginx/html/admin
RUN chown -R nginx:nginx /usr/share/nginx/html
USER nginx
EXPOSE 8080 8443
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl --fail --silent http://127.0.0.1:8080/admin/ >/dev/null || exit 1
ENTRYPOINT ["/docker-entrypoint-tls.sh"]
