      "question": "What is in Internet-Bills-July2026.docx?",
      "expected_documents": ["Internet-Bills-July2026.docx"],
      "evidence": [{"document": "Internet-Bills-July2026.docx", "passage": "41,250"}],
      "expected_facts": ["41,250"],
      "forbidden_facts": ["47,800"]
    },
    {
      "id": "discovery-filename-partial", "scenario": "discovery", "language": "mixed", "persona": "admin", "expect": "answer",
      "question": "Internet-Bills-July2026 phr yeh file kya hai",
      "expected_documents": ["Internet-Bills-July2026.docx"],
      "evidence": [{"document": "Internet-Bills-July2026.docx", "passage": "Agenda for Payments Approval"}],
      "expected_facts": ["Nexlinx|Optix|41,250|Payments Approval"],
      "note": "The user pastes a truncated filename and asks what the file is."
    },
